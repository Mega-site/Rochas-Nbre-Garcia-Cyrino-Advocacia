# ============================================================
# RN & GC Rocha Nobre & Garcia Cyrino Advogados — .htaccess híbrido (Mega Ads)
# No-Cache para HTML/CSS/JS | cache imutável para mídias
# ============================================================

<IfModule mod_headers.c>
  # HTML, CSS e JS: sempre buscar a versão mais recente
  <FilesMatch "\.(html|htm|css|js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Mídias: cache longo e imutável
  <FilesMatch "\.(webp|avif|png|jpg|jpeg|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
</IfModule>
